NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:4173
API_ORIGIN=http://localhost:4173
API_PORT=4100
DATABASE_PATH=./data/auth.db
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_DAYS=30
EMAIL_CODE_TTL_MINUTES=10
EMAIL_DEV_MODE=false

# Email delivery. Resend over HTTPS is preferred, then SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DyToken <no-reply@dyinvest.cn>
SENDMAIL_PATH=/usr/sbin/sendmail
ENABLE_SENDMAIL=false

# OAuth callback URLs use PUBLIC_ORIGIN:
# /api/auth/oauth/google/callback
# /api/auth/oauth/apple/callback
# /api/auth/oauth/github/callback
# /api/auth/oauth/x/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

X_CLIENT_ID=
X_CLIENT_SECRET=
