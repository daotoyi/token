server {
    listen 80;
    listen 443 ssl http2;
    server_name token.dyinvest.cn;

    root /www/wwwroot/token.dyinvest.cn;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|svg|png|jpg|jpeg|webp|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
